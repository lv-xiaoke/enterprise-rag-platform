# PostgreSQL：启动 Compose 的必需公开示例值
POSTGRES_DB=enterprise_rag
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=change-me-local-only

# 宿主机直接运行 Python 时使用；Compose 内的 API 会覆盖为 postgres:5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 容器映射到宿主机的端口；端口冲突时只修改本地环境文件
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000

# LLM：健康检查和知识库 CRUD 可留空；执行生成式问答时必须在本地填写
# LLM_API_KEY 是秘密，绝不能提交真实值
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Web：Compose 浏览器入口，开发模式使用 Vite http://localhost:5173
WEB_HOST_PORT=8080
APP_ORIGIN=http://localhost:8080
# 本地 HTTP 为 false；正式 HTTPS 部署时必须开启
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=168
MAX_UPLOAD_BYTES=10485760
# 保留现有生产基线；0.65 只是旧小样本实验建议
RAG_MIN_RELEVANCE_SCORE=0.55
